<?xml version="1.0" encoding="UTF-8"?>
<manifest>
    <remote name="github-https"
            fetch="https://github.com/oneplus-lemonadep/"
            sync-c="true"
            sync-tags="false"
            revision="15.0" />
    <remote name="gitlab-https"
            fetch="https://gitlab.com/oneplus-lemonadep"
            sync-c="true"
            sync-tags="false"
            revision="15.0" />
    <!-- Device Tree -->
    <project name="android_device_oneplus_lemonadep" path="device/oneplus/lemonadep" remote="github-https" />
    <project name="android_device_oneplus_sm8350-common" path="device/oneplus/sm8350-common" remote="github-https" />
  
    <!-- OnePlus Hardware Specific -->
    <project name="hardware_oplus" path="hardware/oplus" remote="github-https" />
  
    <!-- Kernel Source -->
    <project name="android_kernel_oneplus_sm8350" path="kernel/oneplus/sm8350" remote="github-https" />

    <!-- Vendor Files -->
    <project name="proprietary_vendor_oneplus-lemonadep" path="vendor/oneplus/lemonadep" remote="gitlab-https" />
    <project name="proprietary_vendor_oneplus_sm8350-common" path="vendor/oneplus/sm8350-common" remote="gitlab-https" />

    <!-- crdroidandroid Signing Keys -->
    <project name="Signing_KEYS" path="vendor/lineage/signing/keys" remote="github-https" />

    <!-- To fix Play Integrity -->
    <project name="vendor_extra" path="vendor/extra" remote="github-https" />


</manifest>
